{
  "name": "@plagtech/archon-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for trading on the Archon DEX — the agent-native decentralized exchange",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "copy-abis": "node scripts/copy-abis.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "archon",
    "dex",
    "agents",
    "trading",
    "base",
    "intents",
    "session-keys"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plagtech/archon-sdk.git"
  },
  "author": "Plagtech LLC",
  "license": "MIT",
  "dependencies": {
    "ethers": "^6.15.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
